server {
    listen 8080;
    root /usr/share/nginx/html;

    # Same job as the Vite dev proxy: forward /api/* to FastAPI so the
    # browser only ever talks to this one origin.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets never change, so they can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Single-page app: unknown paths serve index.html and React routes them.
    location / {
        try_files $uri /index.html;
    }
}
